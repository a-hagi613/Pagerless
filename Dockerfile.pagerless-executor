FROM golang:1.27.4-bookworm AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY api/ api/
COPY cmd/pagerless-executor/ cmd/pagerless-executor/
COPY internal/ internal/
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/pagerless-executor ./cmd/pagerless-executor

FROM alpine:3.23.8

RUN apk add --no-cache ca-certificates-bundle=20261020-r0 git=2.52.1-r0
COPY --from=build /out/pagerless-executor /usr/local/bin/pagerless-executor
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/pagerless-executor"]
