FROM golang:1.27.4-bookworm AS build

WORKDIR /src
COPY go.mod go.sum ./
COPY evals/e2e/adapter/ evals/e2e/adapter/
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/pagerless-e2e-adapter ./evals/e2e/adapter

FROM debian:bookworm-slim@sha256:734a72b3d6142a71993b4bc580ca01d8ca687f77a2c422d96a961d3376b179bc

# The Alpine git package does not ship the git-http-backend helper that serves
# the smart HTTP transport, so this image uses Debian's complete git package.
RUN apt-get update \
	&& apt-get install --yes --no-install-recommends \
		ca-certificates=20250419~deb12u2 \
		git=1:2.39.5-0+deb12u3 \
	&& rm -rf /var/lib/apt/lists/*
COPY --from=build /out/pagerless-e2e-adapter /usr/local/bin/pagerless-e2e-adapter
ARG VCS_REF=local
LABEL org.opencontainers.image.source="https://github.com/a-hagi613/pagerless" \
	org.opencontainers.image.revision="$VCS_REF"
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/pagerless-e2e-adapter"]
