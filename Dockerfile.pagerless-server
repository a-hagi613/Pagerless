# The dashboard is built first by the Node version the project pins, and its
# output is embedded in pagerless-server. npm ci installs exactly the lockfile.
FROM node:22.17.1-bookworm AS dashboard

WORKDIR /dashboard
COPY dashboard/package.json dashboard/package-lock.json ./
RUN npm ci
COPY dashboard/ ./
RUN npm run build

FROM golang:1.27.4-bookworm AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY cmd/pagerless-server/ cmd/pagerless-server/
COPY cmd/pagerless-mcp/ cmd/pagerless-mcp/
COPY internal/ internal/
COPY dashboard/embed.go dashboard/embed.go
COPY --from=dashboard /dashboard/dist dashboard/dist
ARG VERSION=local
RUN CGO_ENABLED=0 go build -trimpath \
	-ldflags="-s -w -X main.version=${VERSION}" \
	-o /out/pagerless-server ./cmd/pagerless-server
RUN CGO_ENABLED=0 go build -trimpath \
	-ldflags="-s -w" \
	-o /out/pagerless-mcp ./cmd/pagerless-mcp

FROM alpine:3.23.8

RUN apk add --no-cache ca-certificates-bundle=20261020-r0
COPY --from=build /out/pagerless-server /usr/local/bin/pagerless-server
COPY --from=build /out/pagerless-mcp /usr/local/bin/pagerless-mcp
ARG VERSION=local
ARG VCS_REF=local
LABEL org.opencontainers.image.source="https://github.com/a-hagi613/pagerless" \
	org.opencontainers.image.version="$VERSION" \
	org.opencontainers.image.revision="$VCS_REF"
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/pagerless-server"]
