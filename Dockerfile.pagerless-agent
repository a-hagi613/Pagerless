FROM ghcr.io/astral-sh/uv:0.13.8 AS uv

FROM python:3.14.10-slim-bookworm

COPY --from=uv /uv /uvx /bin/
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_NO_DEV=1 \
    PAGERLESS_AGENT_HOST=0.0.0.0 \
    PAGERLESS_AGENT_PORT=8080

WORKDIR /app
COPY agent/pyproject.toml agent/uv.lock ./
RUN uv sync --locked --no-install-project
COPY agent/src/ ./src/
RUN uv sync --locked --no-dev

ARG VERSION=local
ARG VCS_REF=local
LABEL org.opencontainers.image.source="https://github.com/a-hagi613/pagerless" \
	org.opencontainers.image.version="$VERSION" \
	org.opencontainers.image.revision="$VCS_REF"
# The private Service is the only listener; the container holds no Kubernetes or GitHub
# credential and mounts the internal bearer credential as a read-only file.
EXPOSE 8080
USER 65532:65532
ENTRYPOINT ["python", "-m", "pagerless_agent"]
