# Pinned versions for the local development loop. Read by the Makefile and by
# the scripts in hack/. Each value was verified against its release source when
# it was added; see docs/adr and the README "Development" section.

# Tools checked by hack/preflight.sh and installed by the developer.
KIND_VERSION=v0.33.0
# CI installs this exact binary; the checksum is the release's own sha256sum.
KIND_LINUX_AMD64_SHA256=aee6151561422756b764a4ae28e7f44cda5af5a9eead3cc9985112b1de8d8e0d
KUBECTL_VERSION=v1.37.0
HELM_VERSION=v4.3.2
UV_VERSION=0.13.8
PYTHON_VERSION=3.14.10

# Manifest validation, run by make validate and CI.
KUBECONFORM_VERSION=v0.8.0
KUBECONFORM_LINUX_AMD64_SHA256=9bc2bffbf71f261128533edaf912153948b7ff238f9a531ae6d34466ec287883

# Development cluster. The node image matches Kubernetes 1.37.0 and is pinned by digest.
KIND_CLUSTER_NAME=pagerless
KIND_NODE_IMAGE=kindest/node:v1.37.0@sha256:a1ed56cfb0e7b93589bdf97c8cd566405a265939e3620fc4f5de89adff580ae5

# Pagerless image references shared by make dev. CI publishes these exact tags.
PAGERLESS_SERVER_IMAGE=ghcr.io/a-hagi613/pagerless-server:2.0.0
PAGERLESS_AGENT_IMAGE=ghcr.io/a-hagi613/pagerless-agent:2.0.0

# Minimum memory the Docker engine must provide to kind, in GiB.
MIN_MEMORY_GIB=12
