# Pinned versions for the local bootstrap (make up). Read by the Makefile and
# by the scripts in hack/. Each value was verified against its release source
# when it was added; see docs/adr and the README "Local bootstrap" section.

# Tools checked by hack/preflight.sh and installed by the developer.
KIND_VERSION=v0.33.0
KUBECTL_VERSION=v1.37.0
HELM_VERSION=v4.3.2
UV_VERSION=0.13.8
PYTHON_VERSION=3.14.10

# Manifest validation, run by make validate and CI.
KUBECONFORM_VERSION=v0.8.0
KUBECONFORM_LINUX_AMD64_SHA256=9bc2bffbf71f261128533edaf912153948b7ff238f9a531ae6d34466ec287883

# GitHub CLI, used by make break and make reset to open pull requests and push.
GH_VERSION=v2.104.0

# Cluster. The node image matches Kubernetes 1.37.0 and is pinned by digest.
KIND_CLUSTER_NAME=pagerless
KIND_NODE_IMAGE=kindest/node:v1.37.0@sha256:a1ed56cfb0e7b93589bdf97c8cd566405a265939e3620fc4f5de89adff580ae5

# Argo CD, installed from the argo-helm chart. Chart 10.18.0 ships Argo CD v3.6.1.
ARGOCD_CHART_REPO=https://argoproj.github.io/argo-helm
ARGOCD_CHART_VERSION=10.18.0

# Karpenter, installed from its signed OCI chart (make cloud-up). Chart 1.15.2
# is the release that lists Kubernetes 1.37 in its compatibility matrix.
KARPENTER_CHART_VERSION=1.15.2

# Terraform, used by infra/ and by make cloud-up and make cloud-down.
TERRAFORM_VERSION=1.17.2

# Pagerless image references shared by make up and make dev. CI publishes these exact tags.
PAGERLESS_SERVER_IMAGE=ghcr.io/a-hagi613/pagerless-server:0.2.0
PAGERLESS_EXECUTOR_IMAGE=ghcr.io/a-hagi613/pagerless-executor:0.2.0
PAGERLESS_AGENT_IMAGE=ghcr.io/a-hagi613/pagerless-agent:0.2.0
PAGERLESS_E2E_ADAPTER_IMAGE=ghcr.io/a-hagi613/pagerless-e2e-adapter:0.1.0-e2e

# Minimum memory the Docker engine must provide to kind, in GiB.
MIN_MEMORY_GIB=8
