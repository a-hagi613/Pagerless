# Pinned versions for the local development loop and CI. Read by the Makefile
# and the scripts in hack/. Each value was verified against its release source.

# Tools checked by hack/preflight.sh.
KIND_VERSION=v0.33.0
# CI installs this exact binary; the checksum is the release's own sha256sum.
KIND_LINUX_AMD64_SHA256=aee6151561422756b764a4ae28e7f44cda5af5a9eead3cc9985112b1de8d8e0d
KUBECTL_VERSION=v1.37.0
HELM_VERSION=v4.3.2
UV_VERSION=0.13.8
PYTHON_VERSION=3.14.10

# Manifest validation, run by make validate and CI.
KUBECONFORM_VERSION=v0.8.0
KUBECONFORM_LINUX_AMD64_SHA256=9bc2bffbf71f261128533edaf912153948b7ff238f9a531ae6d34466ec287883

# Development and integration cluster. The node image matches Kubernetes 1.37.0.
KIND_CLUSTER_NAME=pagerless
KIND_NODE_IMAGE=kindest/node:v1.37.0@sha256:a1ed56cfb0e7b93589bdf97c8cd566405a265939e3620fc4f5de89adff580ae5

# Fresh 1.0 distribution coordinates. The legacy v1.0.0 and v2.0.0 releases,
# their images, and their chart are immutable and are never written again.
# The release tag prefix cannot be "v": the legacy v-prefixed tags belong to
# the retired operator.
PAGERLESS_RELEASE_TAG_PREFIX=pagerless-v
PAGERLESS_SERVER_REPOSITORY=ghcr.io/a-hagi613/pagerless/core/server
PAGERLESS_AGENT_REPOSITORY=ghcr.io/a-hagi613/pagerless/core/agent
PAGERLESS_CHART_OCI=oci://ghcr.io/a-hagi613/pagerless/core/charts
PAGERLESS_CHART_NAME=pagerless

# Images built by make build-images and loaded into kind by make dev. The tag
# must equal the chart version; scripts/release/check-versions.sh enforces it.
PAGERLESS_SERVER_IMAGE=ghcr.io/a-hagi613/pagerless/core/server:1.0.1
PAGERLESS_AGENT_IMAGE=ghcr.io/a-hagi613/pagerless/core/agent:1.0.1

# Minimum memory the Docker engine must provide to kind, in GiB.
MIN_MEMORY_GIB=12

# Release tooling, used by make release-snapshot, make release-check, and the
# release workflow. Both binaries are downloaded into bin/release-tools and
# verified against the checksums below.
GORELEASER_VERSION=v2.20.2
GORELEASER_LINUX_AMD64_SHA256=f3d24969a7389a46613875711d15a96d8f6ef1553d84c6ace09d69ac1e7d44c0
SYFT_VERSION=v1.57.2
SYFT_LINUX_AMD64_SHA256=ad92bd3ec1b94a3df01d4d0aec199afa9c42b72e86da436ff5f837914d32706b
# The Krew plugin manager, installed by the release workflow to prove the
# rendered plugin manifest installs.
KREW_VERSION=v0.5.0
KREW_LINUX_AMD64_SHA256=5d5a221fffdf331d1c5c68d9917530ecd102e0def5b5a6d62eeed1c404efb28a
